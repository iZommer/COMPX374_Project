generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Status {
  AVAILABLE
  IN_A_MEETING
  TEACHING
  OUT_OF_OFFICE
}
enum EventSource {
  MANUAL
  ICS_IMPORT
}
model Academic {
  id String @id @default(cuid())
  firebaseUid String @unique
  email String
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  availability AvailabilityStatus?
  events CalendarEvent[]
  contact ContactInfo?
  display DisplayAssociation?
  displaySettings DisplayClientSettings?
}
model AvailabilityStatus {
  academicId String @id
  academic Academic @relation(fields: [academicId], references: [id], onDelete: Cascade)
  status Status @default(AVAILABLE)
  expectedReturnTime DateTime?
  customMessage String?
  overrideStatus Status?
  overrideUntil DateTime?
  overrideMessage String?
  updatedAt DateTime @updatedAt
}
model CalendarEvent {
  id String @id @default(cuid())
  academicId String
  academic Academic @relation(fields: [academicId], references: [id], onDelete: Cascade)
  title String
  startTime DateTime
  endTime DateTime
  status Status @default(IN_A_MEETING)
  source EventSource @default(MANUAL)
  importKey String?
  recurrenceRule String?
  recurrenceExceptions CalendarEventException[]
  @@unique([academicId, importKey])
  @@index([academicId, startTime, endTime])
}
model CalendarEventException {
  id String @id @default(cuid())
  eventId String
  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrenceStart DateTime
  cancelled Boolean @default(false)
  title String?
  startTime DateTime?
  endTime DateTime?
  status Status?
  @@unique([eventId, occurrenceStart])
}
model ContactInfo {
  academicId String @id
  academic Academic @relation(fields: [academicId], references: [id], onDelete: Cascade)
  email String
  phone String @default("")
  officeLocation String @default("")
}
model DisplayAssociation {
  id String @id @default(cuid())
  academicId String @unique
  academic Academic @relation(fields: [academicId], references: [id], onDelete: Cascade)
  apiKey String @unique
  pairedAt DateTime?
}
model DisplayClientSettings {
  academicId String @id
  academic Academic @relation(fields: [academicId], references: [id], onDelete: Cascade)
  textScale String @default("normal")
  highContrast Boolean @default(false)
  pixelShiftEnabled Boolean @default(true)
  idleReturnSeconds Int @default(60)
  staleAfterHours Int @default(24)
  dimStartHour Int @default(19)
  dimEndHour Int @default(7)
  dimLevel Int @default(55)
  timeFormat24h Boolean @default(true)
  updatedAt DateTime @updatedAt
}
