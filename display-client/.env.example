# Base URL of the deployed Diary Server (Vercel), no trailing slash
DIARY_SERVER_URL="https://your-app.vercel.app"

# Display API key for this academic; leave empty to pair on screen
DISPLAY_API_KEY=""

# Poll interval in seconds (clamped to a maximum of 15)
POLL_INTERVAL_SECONDS="10"

# Per-request timeout in milliseconds
REQUEST_TIMEOUT_MS="8000"

# Local server port (bound to 127.0.0.1 only)
PORT="3000"

# Directory for config.json and cache.json
DATA_DIR="/var/lib/where-is-nic"

# IANA timezone used to render times
TIMEZONE="Pacific/Auckland"

# Seconds of touch inactivity before returning to Current Status
IDLE_RETURN_SECONDS="60"

# Hours before cached data is significantly out of date
STALE_AFTER_HOURS="24"

# Enable subtle periodic pixel shifting to reduce burn-in
PIXEL_SHIFT_ENABLED="true"

# Local hour at which overnight dimming starts (empty disables it)
DIM_START_HOUR="22"

# Local hour at which overnight dimming ends
DIM_END_HOUR="7"
