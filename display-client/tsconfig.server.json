{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "composite": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "mock/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
