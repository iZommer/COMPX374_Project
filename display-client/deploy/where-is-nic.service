[Unit]
Description=Where Is Nic Digital Office Display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=where-is-nic
Group=where-is-nic
WorkingDirectory=/opt/where-is-nic
Environment=NODE_ENV=production
EnvironmentFile=-/etc/where-is-nic.env
ExecStart=/usr/bin/node /opt/where-is-nic/dist-node/server/index.js
Restart=always
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/where-is-nic

[Install]
WantedBy=multi-user.target
